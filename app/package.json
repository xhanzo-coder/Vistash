{
  "name": "vistash",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui-kit": "vite --open /?dev=ui-kit",
    "dev:app-shell": "vite --open /?dev=app-shell",
    "dev:library-lifecycle": "vite --open /?dev=library-lifecycle&state=welcome",
    "prototype:image-library": "vite --open /?prototype=image-library&variant=A",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/e2e-app-config.test.mjs scripts/icon-assets.test.mjs scripts/module-boundaries.test.mjs scripts/native-window-shell.test.mjs scripts/release.test.mjs scripts/release-workflows.test.mjs",
    "release:verify": "node scripts/release.mjs verify",
    "release:build": "pnpm release:verify && tauri build --bundles nsis,msi",
    "release:checksums": "node scripts/release.mjs checksums --bundle-dir target/release/bundle --output target/release/bundle/SHA256SUMS.txt",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.102.5",
    "@tanstack/react-virtual": "3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
